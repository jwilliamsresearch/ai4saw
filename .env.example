# ── Provider selection ───────────────────────────────────────────────────────
# One of: ollama | openrouter | huggingface
PROVIDER=ollama

# ── Model defaults ────────────────────────────────────────────────────────────
DEFAULT_MODEL=mistralai/mistral-7b-instruct
# For Ollama, use local model names:  mistral, llama3, etc.
# For OpenRouter, use full namespaced model IDs as above.
# For HuggingFace, use  mistralai/Mistral-7B-Instruct-v0.3  etc.

EMBEDDING_MODEL=nomic-embed-text

# ── API keys (only needed for cloud providers) ────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

HF_API_KEY=

# ── Ollama ────────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ── ChromaDB ─────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=ai4saw

# ── Extraction ────────────────────────────────────────────────────────────────
# Hard limit on LLM token spend per run (approximate, provider-side tracking only)
MAX_TOKENS_PER_RUN=500000

# Retry attempts on JSON parse failure
EXTRACTION_RETRY_LIMIT=2

# ── Retrieval ─────────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=8
RERANK_TOP_N=3

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=./logs/ai4saw.log

# ── Paths ─────────────────────────────────────────────────────────────────────
PROMPTS_DIR=./prompts
OUTPUT_DIR=./output
CORPUS_DIR=./corpus

# ── HTTP ──────────────────────────────────────────────────────────────────────
# Identifies requests to external APIs (required by langchain-community)
USER_AGENT=ai4saw/0.1
